# Flip the touchscreen's Y axis (libinput calibration matrix: y' = 1 - y).
# Needed for the MHS-3.5" panel with the stock `piscreen` overlay, where taps
# land mirrored top-to-bottom. Install, then REBOOT (or restart the desktop):
#   sudo cp 90-touchscreen-flip-y.rules /etc/udev/rules.d/ && sudo reboot
#
# Matched by the device NAME, which is the same on a Pi 4 and a Pi 5. An earlier
# version matched ID_PATH "platform-fe204000.spi-cs-1", the Pi 4's SPI controller
# address, and silently did nothing on the Pi 5 (the SPI bus sits behind the RP1 chip).
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="ADS7846 Touchscreen", ENV{LIBINPUT_CALIBRATION_MATRIX}="1 0 0 0 -1 1"
